{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@thatg33k/seene": ["./src/index.ts"],
      "@thatg33k/seene/preview": ["./src/preview/index.tsx"],
      "@thatg33k/seene/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.performance.config.ts",
    "vite.lib.config.ts",
    "vite.cli.config.ts",
    "app",
    "vite.test.config.ts"
  ]
}
